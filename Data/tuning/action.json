{
  "version": 1,
  "definitions": [
    {"id": "act.press.sigma", "default": 0.45, "min": 0.05, "max": 2, "unit": "s", "tag": "[설계]", "source": "specs/008 FR-02 σ = 0.45 (Bekkers, 리서치 02 §4.1)"},
    {"id": "act.press.T", "default": 1.5, "min": 0.1, "max": 5, "unit": "s", "tag": "[설계]", "source": "specs/008 FR-02 T = 1.5 s"},
    {"id": "act.press.reaction", "default": 0.7, "min": 0, "max": 2, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-02 τ_r — 리서치 02 §4.1 기본, 005 선수값 연결 때 재확인"},
    {"id": "act.press.vmax", "default": 7, "min": 1, "max": 12, "unit": "m/s", "tag": "[대체]", "source": "specs/008 FR-02 v_max — 리서치 02 §4.1 기본"},
    {"id": "act.press.minSpeed", "default": 2, "min": 0, "max": 6, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-02 속도 2 m/s 미만 수비수는 능동 압박 아님"},
    {"id": "act.press.touchline", "default": 0.15, "min": 0, "max": 0.3, "unit": "", "tag": "[제안]", "source": "specs/008 FR-02 터치라인 보정 +0.1~0.2 (기본 0.15)"},
    {"id": "act.press.touchBand", "default": 3, "min": 0, "max": 10, "unit": "m", "tag": "[설계]", "source": "specs/008 FR-02 터치라인 3 m 안"},
    {"id": "act.xpass.b0", "default": 3.2, "min": -10, "max": 10, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b0"},
    {"id": "act.xpass.b1", "default": 0.45, "min": 0, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b1 (dist/10)"},
    {"id": "act.xpass.b2", "default": 1.0, "min": 0, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b2 pressureOnPasser"},
    {"id": "act.xpass.b3", "default": 2.0, "min": 0, "max": 10, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b3 lanePressure"},
    {"id": "act.xpass.b4", "default": 1.5, "min": 0, "max": 10, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b4 receiverPC"},
    {"id": "act.xpass.b5", "default": 0.6, "min": -5, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b5 forwardness"},
    {"id": "act.xpass.b6", "default": 1.2, "min": 0, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b6 Passing"},
    {"id": "act.xpass.b7", "default": 0.5, "min": 0, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-11 b7 Vision"},
    {"id": "act.xpass.laneWidth", "default": 3, "min": 0.5, "max": 10, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-11 lanePressure 계산 레인 반폭 [미정] — 레인 안 상대의 압박 최대값"},
    {"id": "act.pc.scale", "default": 0.5, "min": 0.05, "max": 3, "unit": "s", "tag": "[대체]", "source": "specs/008 007 전 대체 피치 컨트롤: 도달 시간 차 로지스틱 척도 (010 dec.space.scale과 같은 시작값)"},
    {"id": "act.xt.dist", "default": 60, "min": 10, "max": 105, "unit": "m", "tag": "[대체]", "source": "specs/008 007 전 대체 xT: 상대 골에서 이 거리면 0, (1 − d/D)² (010 dec.space.threatDist와 같은 시작값)"},
    {"id": "act.pass.laneRefSpeed", "default": 14, "min": 3, "max": 40, "unit": "m/s", "tag": "[대체]", "source": "specs/008 FR-12 속도 후보별 레인 압박 시간 배수 = t_도착 / (거리/기준 속도), 0.5~2로 자름"},
    {"id": "act.pass.loftLane", "default": 0.3, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "specs/008 FR-12 뜬공 레인 압박 배수 (체공 중 머리 위로 넘어감)"},
    {"id": "act.lead.horizon", "default": 5, "min": 0.5, "max": 10, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-14 스루볼 해 τ 상한"},
    {"id": "act.pass.ground0", "default": 10, "min": 3, "max": 40, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-12 땅볼 속도 후보"},
    {"id": "act.pass.ground1", "default": 14, "min": 3, "max": 40, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-12"},
    {"id": "act.pass.ground2", "default": 18, "min": 3, "max": 40, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-12"},
    {"id": "act.pass.ground3", "default": 22, "min": 3, "max": 40, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-12"},
    {"id": "act.pass.loftLow", "default": 25, "min": 5, "max": 60, "unit": "deg", "tag": "[대체]", "source": "specs/008 FR-12 뜬공 2~3종 — 발사각 낮음"},
    {"id": "act.pass.loftHigh", "default": 40, "min": 5, "max": 70, "unit": "deg", "tag": "[대체]", "source": "specs/008 FR-12 뜬공 — 발사각 높음"},
    {"id": "act.pass.loftPenalty", "default": 0.4, "min": 0, "max": 3, "unit": "", "tag": "[대체]", "source": "specs/008 FR-12 뜬공 xPass logit 감점(체공 중 수신 난이도) [미정]"},
    {"id": "act.recv.decayMin", "default": 0.6, "min": 0.1, "max": 1, "unit": "", "tag": "[설계]", "source": "specs/008 FR-12 λ_recv ×= lerp(1, 0.6, (v−12)/12)"},
    {"id": "act.recv.speedLo", "default": 12, "min": 0, "max": 40, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-12"},
    {"id": "act.recv.speedSpan", "default": 12, "min": 1, "max": 40, "unit": "m/s", "tag": "[설계]", "source": "specs/008 FR-12"},
    {"id": "act.recv.touchRelief", "default": 0.5, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "specs/008 FR-12 퍼스트터치가 높을수록 감쇠 감소 — 크기 [미정]"},
    {"id": "act.err.angleMax", "default": 7, "min": 0, "max": 30, "unit": "deg", "tag": "[설계]", "source": "specs/008 FR-13 σ_angle = lerp(7°, 1.5°, a_Passing)"},
    {"id": "act.err.angleMin", "default": 1.5, "min": 0, "max": 30, "unit": "deg", "tag": "[설계]", "source": "specs/008 FR-13"},
    {"id": "act.err.pressK", "default": 0.8, "min": 0, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-13 × (1 + 0.8·pressure)"},
    {"id": "act.err.composureK", "default": 0.5, "min": 0, "max": 5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-13 × (1 + 0.5·(1 − a_Composure))"},
    {"id": "act.err.speedMax", "default": 0.15, "min": 0, "max": 1, "unit": "", "tag": "[설계]", "source": "specs/008 FR-13 σ_speed = lerp(15%, 4%, a_Passing)"},
    {"id": "act.err.speedMin", "default": 0.04, "min": 0, "max": 1, "unit": "", "tag": "[설계]", "source": "specs/008 FR-13"},
    {"id": "act.lead.l0", "default": 0, "min": 0, "max": 20, "unit": "m", "tag": "[설계]", "source": "specs/008 FR-14 lead 후보 {0,2,4,6}"},
    {"id": "act.lead.l1", "default": 2, "min": 0, "max": 20, "unit": "m", "tag": "[설계]", "source": "specs/008 FR-14"},
    {"id": "act.lead.l2", "default": 4, "min": 0, "max": 20, "unit": "m", "tag": "[설계]", "source": "specs/008 FR-14"},
    {"id": "act.lead.l3", "default": 6, "min": 0, "max": 20, "unit": "m", "tag": "[설계]", "source": "specs/008 FR-14"},
    {"id": "act.ctrl.radius", "default": 1.0, "min": 0.2, "max": 3, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-45 컨트롤 반경 [미정]"},
    {"id": "act.ctrl.maxZ", "default": 2.5, "min": 0.5, "max": 4, "unit": "m", "tag": "[설계]", "source": "specs/008 AC-03 높이 > 2.5 m 필드 선수 인터셉트 0"},
    {"id": "act.ctrl.base", "default": 4.5, "min": -5, "max": 10, "unit": "", "tag": "[대체]", "source": "specs/008 FR-45 컨트롤 판정 logit 기준 [미정] (선수별 최근접 순간 1회 판정, 몸 중심 거리 0·공 속도 기준 이하)"},
    {"id": "act.ctrl.distK", "default": 2, "min": 0, "max": 10, "unit": "", "tag": "[대체]", "source": "specs/008 FR-45 최근접 거리/반경 1당 logit 감점"},
    {"id": "act.ctrl.speedRef", "default": 5, "min": 0, "max": 20, "unit": "m/s", "tag": "[대체]", "source": "specs/008 FR-45 이 속도 넘는 공부터 감점"},
    {"id": "act.ctrl.speedK", "default": 0.1, "min": 0, "max": 1, "unit": "1/(m/s)", "tag": "[대체]", "source": "specs/008 FR-45 공 속도 감점 (logit, m/s당)"},
    {"id": "act.ctrl.touchK", "default": 1.0, "min": 0, "max": 5, "unit": "", "tag": "[대체]", "source": "specs/008 FR-45 FirstTouch logit 보정 k·(a − 0.5) (FR-01)"},
    {"id": "act.ctrl.pressK", "default": 1.0, "min": 0, "max": 5, "unit": "", "tag": "[대체]", "source": "specs/008 FR-45 받는 선수 압박 감점 (logit)"},
    {"id": "act.ctrl.defPenalty", "default": 2.5, "min": 0, "max": 5, "unit": "", "tag": "[대체]", "source": "specs/008 FR-45 λ_def: 상대 패스 차단(몸 방향·예측 불리) logit 감점 [미정]"},
    {"id": "act.ctrl.highZ", "default": 1.0, "min": 0, "max": 3, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-45 이 높이 넘는 공은 가슴·머리 컨트롤 감점"},
    {"id": "act.ctrl.highPenalty", "default": 0.5, "min": 0, "max": 5, "unit": "", "tag": "[대체]", "source": "specs/008 FR-45 높은 공 감점 (logit)"},
    {"id": "act.ctrl.freeSpeed", "default": 2, "min": 0, "max": 5, "unit": "m/s", "tag": "[대체]", "source": "specs/008 FR-45 이 속도 미만 느슨한 공은 반경 안 첫 선수가 그대로 잡음(판정 1회 소비)"},
    {"id": "act.xpass.sampleDt", "default": 0.05, "min": 0.01, "max": 0.2, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-10 물리 xPass 선수 판정 샘플 간격 (성능 예산 80 µs)"},
    {"id": "act.xpass.horizon", "default": 3, "min": 0.5, "max": 6, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-10 물리 xPass 궤적 상한 (성능 예산 표 '3 s 궤적')"},
    {"id": "act.touch.sigmaBase", "default": 1.8, "min": 0, "max": 5, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-67 [미정] → 리서치 03 B2 대안 FirstTouch 이격 σ 1.8 − 1.4s m"},
    {"id": "act.touch.sigmaSlope", "default": 1.4, "min": 0, "max": 5, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-67 (리서치 03 B2)"},
    {"id": "act.touch.pressK", "default": 0.5, "min": 0, "max": 5, "unit": "", "tag": "[대체]", "source": "specs/008 FR-67 압박 배수 (1 + k·pressure)"},
    {"id": "act.touch.angle", "default": 60, "min": 0, "max": 180, "unit": "deg", "tag": "[대체]", "source": "specs/008 FR-67 이격 방향 범위 ±"},
    {"id": "act.touch.controlDist", "default": 1.5, "min": 0, "max": 3, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-67 이 거리 이하 이격은 컨트롤 유지(몰고 가는 거리), 넘으면 느슨한 공 — 불안한 터치 기준과 같은 시작값 (T13 1차 조정: 0.5면 수신 65%가 느슨한 공)"},
    {"id": "act.touch.heavy", "default": 1.5, "min": 0, "max": 5, "unit": "m", "tag": "[설계]", "source": "specs/008 FR-67 이격 > 1.5 m 불안한 터치 (070 FR-14)"},
    {"id": "act.touch.cooldown", "default": 0.05, "min": 0, "max": 1, "unit": "s", "tag": "[대체]", "source": "specs/008 첫 터치 이격 뒤 수신자 재접촉 쿨다운"},
    {"id": "act.kick.reach", "default": 0.9, "min": 0.3, "max": 2, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-65 사용 발 도달 거리 [미정]"},
    {"id": "act.kick.windupInside", "default": 0.15, "min": 0, "max": 1, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-66 킥 준비 시간 — 인사이드"},
    {"id": "act.kick.windupInstep", "default": 0.25, "min": 0, "max": 1, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-66 — 인스텝"},
    {"id": "act.kick.windupOutside", "default": 0.12, "min": 0, "max": 1, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-66 — 아웃사이드"},
    {"id": "act.kick.windupChip", "default": 0.22, "min": 0, "max": 1, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-66 — 칩"},
    {"id": "act.kick.windupTurnK", "default": 0.2, "min": 0, "max": 2, "unit": "s/rad", "tag": "[대체]", "source": "specs/008 FR-66 몸–킥 방향 차이가 준비 시간을 늘림"},
    {"id": "act.kick.instepSpeed", "default": 18, "min": 0, "max": 40, "unit": "m/s", "tag": "[대체]", "source": "specs/008 FR-66 이 속도 이상 땅볼은 인스텝 (기술 선택 규칙 대체, FR-71 ③ 매핑 [미정])"},
    {"id": "act.kick.chipMaxDist", "default": 25, "min": 0, "max": 80, "unit": "m", "tag": "[대체]", "source": "specs/008 FR-66 이 거리 이하 뜬공은 칩"},
    {"id": "act.kick.angleThresh", "default": 60, "min": 0, "max": 180, "unit": "deg", "tag": "[대체]", "source": "specs/008 FR-66 몸–킥 방향 차이 임계 [미정]"},
    {"id": "act.kick.sigmaMul", "default": 1.5, "min": 1, "max": 5, "unit": "", "tag": "[대체]", "source": "specs/008 FR-66 임계 초과 σ 배수 [미정]"},
    {"id": "act.kick.weakFootK", "default": 0.25, "min": 0, "max": 2, "unit": "", "tag": "[대체]", "source": "specs/008 FR-66 약발 σ ×(1 + k·(5 − 등급)/4) — 002 연결 때 재확인"},
    {"id": "act.kick.timeout", "default": 1.0, "min": 0.1, "max": 5, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-65 예약 킥이 도달 거리 밖으로 남으면 취소"},
    {"id": "act.after.kickSlow", "default": 0.6, "min": 0.1, "max": 1, "unit": "", "tag": "[대체]", "source": "specs/008 FR-64 킥·터치 직후 최대 속도 비율 (005 명령 상한)"},
    {"id": "act.after.duration", "default": 0.3, "min": 0, "max": 2, "unit": "s", "tag": "[대체]", "source": "specs/008 FR-64 킥·터치 직후 감속 지속"},
    {"id": "act.habit.oneTouch", "default": 0.05, "min": 0, "max": 0.5, "unit": "", "tag": "[설계]", "source": "specs/008 FR-71 ② 원터치 마스터 정확도 +5% → σ×(1 − 0.05) (기획서 4.2.1 버릇 표)"},
    {"id": "act.ctrl.keeperMul", "default": 1.8, "min": 1, "max": 3, "unit": "", "tag": "[대체]", "source": "specs/008 GK 자기 박스 손 사용 컨트롤 반경 배수 (011 이전 특례 1.8배 유지)"},
    {"id": "act.lead.minRunnerSpeed", "default": 3, "min": 0, "max": 10, "unit": "m/s", "tag": "[대체]", "source": "specs/008 FR-14 스루볼 후보: 공격 방향 속도가 이 이상인 러너만 (072 FR-02 전 대체)"},
    {"id": "act.pass.loftMaxApex", "default": 40, "min": 5, "max": 60, "unit": "m", "tag": "[대체]", "source": "specs/008 뜬공 실행 004 역산 정점 상한"},
    {"id": "act.recv.ahead", "default": 0.3, "min": 0, "max": 2, "unit": "s", "tag": "[대체]", "source": "specs/008 T14a 받는 지점: 공 경로 위 최근접점의 최소 앞 시간"},
    {"id": "act.oneTouch.ticks", "default": 2, "min": 0, "max": 10, "unit": "tick", "tag": "[대체]", "source": "specs/008 FR-71 원터치 판정: 소유 시작 뒤 이 틱 수 안의 패스"},
    {"id": "act.standin.noise", "default": 0.15, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "specs/008 T14 대체 패스 선택(072 자리) 잡음 U(0, x)"},
    {"id": "act.standin.xtK", "default": 10, "min": 0, "max": 50, "unit": "", "tag": "[대체]", "source": "specs/008 T14 대체 패스 점수 = xPass × max(floor, 1 + xtK·ΔxT + gainK·전진)"},
    {"id": "act.standin.gainK", "default": 0.02, "min": 0, "max": 0.2, "unit": "1/m", "tag": "[대체]", "source": "specs/008 T14 대체 패스 점수 전진 거리 계수"},
    {"id": "act.standin.floor", "default": 0.05, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "specs/008 T14 대체 패스 점수 하한 배수"},
    {"id": "act.prob.min", "default": 0.001, "min": 0, "max": 0.1, "unit": "", "tag": "[제안]", "source": "specs/008 경계: 확률 0.001~0.999 자르기"},
    {"id": "act.prob.max", "default": 0.999, "min": 0.9, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/008 경계"}
  ]
}
