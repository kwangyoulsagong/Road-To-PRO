    {"id": "gk.reach.r0", "default": 0.8, "min": 0.2, "max": 2, "unit": "m", "tag": "[설계]", "source": "specs/011 FR-03 r0 ≈ 0.8 m (리서치 04 § A2 권장 기본값)"},
