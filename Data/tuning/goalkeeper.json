    {"id": "gk.map.react.base", "default": 0.32, "min": 0.1, "max": 0.6, "unit": "s", "tag": "[설계]", "source": "specs/011 FR-70 Reflexes → t_react = 0.32 − 0.14·n (리서치 04 § A7)"},
