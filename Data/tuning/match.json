    {"id": "standin.passExtraSpeed", "default": 3, "min": 0, "max": 15, "unit": "m/s", "tag": "[대체]", "source": "대체 단계 전용: 땅볼 역산 잔여 속도"},
    {"id": "standin.claimRadius", "default": 1.0, "min": 0.3, "max": 3, "unit": "m", "tag": "[대체]", "source": "대체 단계 전용: 느슨한 공 잡는 거리"},
    {"id": "standin.restartTakeMaxSpeed", "default": 0.5, "min": 0.1, "max": 3, "unit": "m/s", "tag": "[제안]", "source": "086 FR-01: 재시작·킥오프 키커는 이 속도 이하로 멈춘 뒤 공을 잡는다 (058 FR-08 공 멈춤 기준과 같은 값, 2026-11-18 사용자 승인)"},
    {"id": "standin.claimMaxZ", "default": 1.9, "min": 0.2, "max": 3, "unit": "m", "tag": "[대체]", "source": "대체 단계 전용: 잡을 수 있는 공 높이"},
    {"id": "standin.claimMaxSpeed", "default": 22, "min": 1, "max": 40, "unit": "m/s", "tag": "[대체]", "source": "대체 단계 전용: 잡을 수 있는 공 속도"},
    {"id": "standin.tackleRange", "default": 1.2, "min": 0.3, "max": 3, "unit": "m", "tag": "[대체]", "source": "대체 단계 전용"},
    {"id": "standin.tackleProb", "default": 0.12, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "대체 단계 전용: 결정마다 태클 성공 확률"},
    {"id": "standin.shapeShiftX", "default": 0.35, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "대체 단계 전용: 대형이 공 쪽으로 이동하는 비율"},
    {"id": "standin.shapeShiftY", "default": 0.25, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "대체 단계 전용"},
    {"id": "standin.penaltyScoreProb", "default": 0.76, "min": 0, "max": 1, "unit": "", "tag": "[대체]", "source": "대체 단계 전용: 승부차기·페널티 득점 확률 — 008·011이 판정할 때까지"},
    {"id": "standin.carrySpeedRatio", "default": 0.7, "min": 0.1, "max": 1, "unit": "", "tag": "[대체]", "source": "대체 단계 전용: 드리블 이동 속도 비율"},
    {"id": "standin.restartWaitMax", "default": 30, "min": 1, "max": 120, "unit": "s", "tag": "[대체]", "source": "specs/058 FR-09 재시작 대기 상한 [미정](012) — 058 플랜 대체 값, 넘으면 현재 위치로 재시작"},
    {"id": "deadball.goalCelebration", "default": 7, "min": 0, "max": 20, "unit": "s", "tag": "[설계]", "source": "specs/058 FR-02 ① 세리머니 단계 = 018 골 연장 +7 s (059 Q5 (a)). 060이 같은 값을 읽는다"},
    {"id": "deadball.arriveRadius", "default": 1.0, "min": 0.1, "max": 5, "unit": "m", "tag": "[제안]", "source": "specs/058 FR-02 ③ 킥오프 배치 도착 반경"},
    {"id": "deadball.returnSpeedMin", "default": 0.4, "min": 0.1, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/058 FR-03 복귀 속도 하한 (최고 속도 비)"},
    {"id": "deadball.returnSpeedMax", "default": 0.6, "min": 0.1, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/058 FR-03 복귀 속도 상한 (최고 속도 비)"},
    {"id": "deadball.restartArriveRadius", "default": 3, "min": 0.5, "max": 10, "unit": "m", "tag": "[제안]", "source": "specs/058 FR-09 재시작 배치 도착 반경"},
    {"id": "deadball.restartArriveShare", "default": 0.8, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/058 FR-09 배치 도착 비율"},
    {"id": "deadball.ballOutRelocate", "default": 3, "min": 0, "max": 10, "unit": "m", "tag": "[제안]", "source": "specs/058 FR-08 공이 경기장 밖 이 거리 이상이면 그 구간 끝에서 재배치"},
    {"id": "deadball.relocateMaxWait", "default": 2, "min": 0, "max": 10, "unit": "s", "tag": "[대체]", "source": "specs/058 FR-08 재배치 대기 상한 — 058 플랜 대체 값(012 전)"},
    {"id": "deadball.walkOffMargin", "default": 1.5, "min": 0, "max": 2.5, "unit": "m", "tag": "[제안]", "source": "specs/058 FR-61·65 걸어 나가는 선수가 터치라인을 넘어 이 거리에 도착하면 퇴장 완료. 상한은 운동 경계 kin.bounds.margin(3 m) − 도착 반경 0.5 m (리뷰 L2)"},

    {"id": "ref.foul.wIntensity", "default": 0.4, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: FR-21 심각도 강도 가중 (리서치 07 § 1.4 예시 0.45 → 늦음 항 확보)"},
    {"id": "ref.foul.wBehind", "default": 0.2, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: FR-21 뒤에서 가중 (리서치 07 § 1.4)"},
    {"id": "ref.foul.wStuds", "default": 0.08, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: FR-21 발바닥 가중 (리서치 07 § 1.4) | 012: T29 보정 0.25 → 0.08 (실경기 슬라이딩 파울 90 % → 33 %, AC-23)"},
    {"id": "ref.foul.wHeight", "default": 0.05, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: FR-21 높이 가중 (0.10 → 0.05)"},
    {"id": "ref.foul.wLate", "default": 0.1, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: FR-21 늦음 가중 (신규)"},
    {"id": "ref.foul.heightFull", "default": 1.2, "min": 0.3, "max": 2.5, "unit": "m", "tag": "[제안]", "source": "specs/012 P1: 높이 항 = 접촉 높이 / 이 값 (1 상한)"},
    {"id": "ref.foul.ballFirstK", "default": 0.7, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-21: 파울 점수 = 심각도 × (1 − k·공 먼저)"},
