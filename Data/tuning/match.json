    {"id": "standin.goalCelebration", "default": 40, "min": 0, "max": 120, "unit": "s", "tag": "[대체]", "source": "대체 단계 전용(디자인 값 아님): 골 후 킥오프까지 데드볼 — 012·027이 실제 값을 줄 때까지"},
    {"id": "standin.subDelay", "default": 25, "min": 0, "max": 120, "unit": "s", "tag": "[대체]", "source": "대체 단계 전용: 교체 1건이 늘리는 데드볼"},
