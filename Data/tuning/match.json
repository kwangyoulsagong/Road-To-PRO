    {"id": "ref.foul.threshold", "default": 0.4, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: 파울 임계 (리서치 07 § 1.4) | 012: T29 보정 0.30 → 0.40 (스탠딩 태클 파울률 25 % → 12.5 %, AC-23)"},
    {"id": "ref.foul.yellow", "default": 0.55, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P1: 경고 임계 (리서치 07 § 1.4) | 012: T29 보정 0.60 → 0.55 (파울 임계 상향에 맞춤, 반칙 경고 ≈ 2.4/경기)"},
    {"id": "ref.foul.red", "default": 0.8, "min": 0, "max": 1.5, "unit": "", "tag": "[제안]", "source": "specs/012 P1: 퇴장 임계 (리서치 07 § 1.4) | 012: T29 보정 0.85 → 0.80 (직접 퇴장 ≈ 0.03/경기)"},
    {"id": "ref.foul.repeatCount", "default": 3, "min": 1, "max": 10, "unit": "", "tag": "[제안]", "source": "specs/012 FR-26: 같은 선수 이 번째 반칙부터 경고 임계를 낮춤"},
    {"id": "ref.foul.repeatDrop", "default": 0.15, "min": 0, "max": 0.5, "unit": "", "tag": "[제안]", "source": "specs/012 FR-26: 반복 반칙 경고 임계 감소량"},
    {"id": "ref.dogso.dist", "default": 30, "min": 5, "max": 60, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-23: 골까지 거리 < 30 m (scenarios 03 § 5.2)"},
    {"id": "ref.dogso.cos", "default": 0.7, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-23: 골 방향 cos > 0.7 (scenarios 03 § 5.2)"},
    {"id": "ref.dogso.control", "default": 0.7, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-23: 공 통제 확률 > 0.7 (scenarios 03 § 5.2)"},
    {"id": "ref.spa.dist", "default": 35, "min": 5, "max": 70, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-26: SPA(유망한 공격 저지) = DOGSO 아님 ∧ 골까지 < 35 m"},
    {"id": "ref.spa.cos", "default": 0.5, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-26: SPA 골 방향 cos > 0.5"},
    {"id": "ref.spa.control", "default": 0.5, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-26: SPA 공 통제 확률 > 0.5"},
    {"id": "ref.spa.defenders", "default": 2, "min": 0, "max": 11, "unit": "", "tag": "[제안]", "source": "specs/012 FR-26: SPA 공–골 사이 수비수 ≤ 2"},
    {"id": "ref.profile.strictShift", "default": 0.2, "min": 0, "max": 0.5, "unit": "", "tag": "[제안]", "source": "specs/012 FR-30: 엄격함 0~1 → 경고·퇴장 임계 ± (엄격 − 0.5) × 이 값"},
    {"id": "ref.profile.foulShift", "default": 0.1, "min": 0, "max": 0.5, "unit": "", "tag": "[제안]", "source": "specs/012 FR-30: 파울 임계 변수 0~1 → 파울 임계 ± (값 − 0.5) × 이 값"},
    {"id": "ref.profile.homeBiasMax", "default": 0.05, "min": 0, "max": 0.2, "unit": "", "tag": "[제안]", "source": "specs/012 FR-30: 홈 편향 상한 0~0.05 (리서치 07 § 1.3)"},
    {"id": "ref.profile.pressureK", "default": 0.5, "min": 0, "max": 2, "unit": "", "tag": "[제안]", "source": "specs/012 FR-30: 압박 저항 낮으면 빅매치·막판 노이즈 × (1 + k·(1 − 저항)·압박)"},
    {"id": "ref.perc.sigma0", "default": 0.12, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P2: 인지 노이즈 σ = σ0·(1.5 − 일관성)·(1.5 − 시야)"},
    {"id": "ref.perc.bestMin", "default": 15, "min": 0, "max": 60, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-32: 시야 최적 거리 15~25 m (리서치 07 § 1.4)"},
    {"id": "ref.perc.bestMax", "default": 25, "min": 0, "max": 60, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-32: 시야 최적 거리 상한"},
    {"id": "ref.perc.far", "default": 55, "min": 10, "max": 120, "unit": "m", "tag": "[제안]", "source": "specs/012 P2: 이 거리에서 거리 항 = 최저"},
    {"id": "ref.perc.distMin", "default": 0.4, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P2: 거리 항 최저값"},
    {"id": "ref.perc.nearMin", "default": 0.7, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P2: 0 m 거리 항 (너무 가까우면 시야 좁음)"},
    {"id": "ref.perc.occWidth", "default": 1.0, "min": 0.1, "max": 3, "unit": "m", "tag": "[제안]", "source": "specs/012 P2: 주심–사건 선분에서 이 거리 안 선수 = 가림"},
    {"id": "ref.perc.occPenalty", "default": 0.2, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P2: 가림 1명당 시야 감소"},
    {"id": "ref.perc.occMax", "default": 3, "min": 0, "max": 10, "unit": "", "tag": "[제안]", "source": "specs/012 P2: 가림 인원 상한"},
    {"id": "ref.perc.arAssist", "default": 0.2, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-32: 가까운 부심(20 m 안)이 사건을 보면 시야 + 이 값 × (1 − 시야)"},
    {"id": "ref.perc.arRange", "default": 20, "min": 0, "max": 60, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-32: 부심 도움 거리"},
    {"id": "ref.dive.foolBase", "default": 0.35, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P8: 속임 = base·(1 − 시야)·(1 − 0.5·일관성) + 약한 접촉 가산"},
    {"id": "ref.dive.foolWeak", "default": 0.15, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P8: 약한 접촉 다이빙 속임 가산"},
    {"id": "ref.dive.cardProb", "default": 0.6, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P8: 들킨 다이빙 경고 확률"},
    {"id": "ref.adv.window", "default": 3.0, "min": 0.5, "max": 10, "unit": "s", "tag": "[제안]", "source": "specs/012 FR-41: 보류 창 (리서치 07 § 1.1 약 2~3 s, 설계 예시 3 s)"},
    {"id": "ref.adv.base", "default": 0.3, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 P5: 이득 점수 = 점유 유지 × clamp(base + 위협도)"},
    {"id": "ref.adv.threatRange", "default": 40, "min": 5, "max": 100, "unit": "m", "tag": "[제안]", "source": "specs/012 P5: 위협도 = clamp(1 − 상대 골까지 거리 / 이 값) (xT 표 전 대체)"},
    {"id": "ref.hand.react", "default": 0.4, "min": 0.05, "max": 2, "unit": "s", "tag": "[제안]", "source": "specs/012 FR-50: 반응 시간이 이 값 이상이면 반응 항 1 (선형)"},
    {"id": "ref.hand.near", "default": 0.5, "min": 0, "max": 3, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-50: 이 거리 안 + 반응 부족 = 근거리 굴절 면제"},
    {"id": "ref.hand.threshold", "default": 0.5, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-50: 실루엣 × 반응 항이 이 값 초과면 진짜 핸드볼"},
    {"id": "ref.off.bodyReach", "default": 0.25, "min": 0, "max": 1, "unit": "m", "tag": "[제안]", "source": "specs/012 P11: 몸 앞쪽 끝 = 위치 + 공격 방향 × 0.25 m (팔 제외)"},
    {"id": "ref.off.sigma0", "default": 0.25, "min": 0, "max": 2, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-07: σ_AR = 0.25 + 0.04 × |부심 정렬 차| (scenarios 03 § 4.2)"},
    {"id": "ref.off.sigmaK", "default": 0.04, "min": 0, "max": 1, "unit": "", "tag": "[제안]", "source": "specs/012 FR-07: σ_AR 거리 계수"},
    {"id": "ref.off.flashMin", "default": 0.3, "min": 0, "max": 2, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-07: flash-lag 하한 (공격수 쪽)"},
    {"id": "ref.off.flashMax", "default": 0.5, "min": 0, "max": 2, "unit": "m", "tag": "[제안]", "source": "specs/012 FR-07: flash-lag 상한"},
    {"id": "ref.off.flashSpeed", "default": 8, "min": 0.5, "max": 15, "unit": "m/s", "tag": "[제안]", "source": "specs/012 FR-07: flash-lag × clamp(공격수 속도 / 이 값) — 움직임이 없으면 0"},
